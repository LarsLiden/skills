{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/msr-central/laliden_skills/schema/skill-schema.json",
  "title": "Skill Manifest",
  "description": "Schema for skill.yml manifest files",
  "type": "object",
  "required": ["name", "description", "version", "entrypoint"],
  "additionalProperties": false,
  "properties": {
    "name": {
      "type": "string",
      "description": "Unique skill identifier (kebab-case)",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "description": {
      "type": "string",
      "description": "Short human-readable description of what the skill does"
    },
    "version": {
      "type": "string",
      "description": "Semantic version of the skill",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "author": {
      "type": "string",
      "description": "GitHub username or display name of the skill author"
    },
    "entrypoint": {
      "type": "string",
      "description": "Path to the main executable or script relative to the skill directory"
    },
    "language": {
      "type": "string",
      "description": "Primary language/runtime of the skill",
      "enum": ["python", "javascript", "typescript", "bash", "go", "other"]
    },
    "inputs": {
      "type": "array",
      "description": "Input parameters accepted by the skill",
      "items": {
        "type": "object",
        "required": ["name", "description", "type"],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "description": "Parameter name"
          },
          "description": {
            "type": "string",
            "description": "What this input is for"
          },
          "type": {
            "type": "string",
            "enum": ["string", "number", "boolean", "array", "object"]
          },
          "required": {
            "type": "boolean",
            "default": false
          },
          "default": {
            "description": "Default value if not provided"
          }
        }
      }
    },
    "outputs": {
      "type": "array",
      "description": "Outputs produced by the skill",
      "items": {
        "type": "object",
        "required": ["name", "description", "type"],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": ["string", "number", "boolean", "array", "object"]
          }
        }
      }
    },
    "tags": {
      "type": "array",
      "description": "Searchable tags for categorising the skill",
      "items": {
        "type": "string"
      }
    },
    "dependencies": {
      "type": "object",
      "description": "External tools or packages required by the skill",
      "properties": {
        "python": {
          "type": "array",
          "items": { "type": "string" }
        },
        "npm": {
          "type": "array",
          "items": { "type": "string" }
        },
        "system": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    }
  }
}
